# DeepScholar Configuration

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, gemini
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-pro

# Embedding Model
EMBEDDING_PROVIDER=openai  # Options: openai, huggingface
EMBEDDING_MODEL=text-embedding-3-small
# HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database
VECTORDB_TYPE=faiss  # Options: faiss, chroma
VECTORDB_PATH=./data/embeddings/faiss_db

# Web Search
WEB_SEARCH_PROVIDER=tavily  # Options: tavily, serpapi, google
TAVILY_API_KEY=your_tavily_api_key_here
# SERPAPI_API_KEY=your_serpapi_api_key_here
# GOOGLE_SEARCH_API_KEY=your_google_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Memory Configuration
MEMORY_TYPE=hybrid  # Options: in_memory, redis, hybrid
MEMORY_MAX_TOKENS=4000
SESSION_MEMORY_DIR=./data/memory/sessions
PERSISTENT_MEMORY_DIR=./data/memory/persistent

# Document Processing
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=100

# RAG Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
CONTEXT_WINDOW_TOKENS=2000
ENABLE_RERANKING=true

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Application
DEBUG=false
ENVIRONMENT=production
PORT=8501
HOST=0.0.0.0
